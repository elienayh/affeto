# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# URL do projeto Supabase (ex: https://ropgdbgkjghwdxdglchz.supabase.co)
VITE_SUPABASE_URL="https://ropgdbgkjghwdxdglchz.supabase.co"
# Chave pública anon (segura para o navegador, protegida por Row Level Security - RLS)
VITE_SUPABASE_ANON_KEY=""
# Chave privada de serviço (somente backend / server-side, nunca exposta ao cliente)
SUPABASE_SERVICE_ROLE_KEY=""

# MERCADO PAGO CONFIGURATION (Server-side only)
# Token de acesso do Mercado Pago (Sandbox: TEST-... ou Produção: APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo de assinatura do Webhook para validação de integridade x-signature
MERCADOPAGO_WEBHOOK_SECRET=""

# WHATSAPP COMERCIAL / LOJA
# Telefone celular da padaria para recebimento de pedidos e contato (DDI+DDD+Número)
VITE_BAKERY_WHATSAPP_NUMBER="5532984680513"

